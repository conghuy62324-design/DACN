# Agent Core uses the existing database/catalog and /assistant page.
# Deterministic, server-verified operations are available without an LLM.
AGENT_CORE_LLM_ENABLED=false
# Optional grounded fact selection and service clarification in native consultations.
AI_NATIVE_CONSULTATION_MODEL_ENABLED=false
LLM_PROVIDER=ollama
LLM_LIVE_ENABLED=false
LLM_USAGE_APPROVED=false
OLLAMA_LOCAL_ONLY_CONFIRMED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MODEL_DIGEST=0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0
# Production Agent admission requires the approved PostgreSQL coordination role.
# Keep DSN and the same 32-byte HMAC key for every backend in the external secret store.
# AGENT_SHARED_STATE_MODE=postgres
# AGENT_STATE_DATABASE_URL=
# AGENT_STATE_DATABASE_NAME=
# AGENT_STATE_HMAC_KEY_HEX=
# AGENT_STATE_TLS=true
# Test only: exact approved isolated database and approval expiry.
# AGENT_STATE_TEST_UNTIL=
# Keep mutation disabled until an isolated, non-superuser staging DB is approved.
# Existing publicStagingGuard also verifies exact database name and sentinel.
PUBLIC_STAGING_WRITES_APPROVED=false
