{
  "name": "travelgo-backend",
  "version": "1.0.0",
  "description": "TravelGo REST API backend with Express, TypeScript, Sequelize, PostgreSQL/PostGIS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "npm run build --silent && node dist/seed.js",
    "db:migrate": "npm run build --silent && node dist/scripts/migrate.js",
    "db:migrate:apply": "npm run build --silent && node dist/scripts/migrate.js --apply",
    "db:verify": "npm run build --silent && node dist/scripts/verifyDatabase.js",
    "ai:export": "npm run build --silent && node dist/scripts/exportAiDataset.js",
    "test": "npm run build --silent && node dist/tests/rbac.test.js",
    "test:algorithm": "npm run build --silent && node dist/tests/algorithm.test.js",
    "test:integration": "npm run build --silent && node dist/tests/integration.postgres.test.js",
    "test:intelligence": "npm run build --silent && node dist/tests/intelligence.postgres.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
