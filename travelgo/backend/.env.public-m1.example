# Example only. No resources/credentials approved or provisioned.
NODE_ENV=test
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=travelgo_public_staging
DB_USER=travelgo_runtime
DB_PASSWORD=
ALLOW_TEST_DB_WRITES=false
# A separately provisioned staging DB/least-privilege runtime/migration/admin split is required.
LLM_LIVE_ENABLED=false
LLM_USAGE_APPROVED=false
LLM_EXTERNAL_PROCESSING_APPROVED=false
LLM_PROVIDER=gemini
GEMINI_FUNCTION_CALLING_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash
# Set to the explicitly reviewed returned modelVersion; mismatch fails closed.
GEMINI_EXPECTED_MODEL_VERSION=gemini-3.8-flash
GEMINI_API_KEY=
GOOGLE_MAPS_USAGE_APPROVED=false
GOOGLE_MAPS_SERVER_KEY=
# Per-process budget, not a replacement for Google Cloud project quotas/billing alerts.
GOOGLE_MAPS_REQUESTS_PER_DAY=100
PUBLIC_AGENT_ENABLED=false
PUBLIC_STAGING_WRITES_APPROVED=false
PUBLIC_STAGING_DB_NAME=travelgo_public_staging
# Must match a separately approved, freshly measured DB comment/identity, never the old test sentinel.
PUBLIC_STAGING_DB_SENTINEL=
# Existing G2 remains local-only. Do not enable external history by changing this setting.
AGENT_G2_MODE=
