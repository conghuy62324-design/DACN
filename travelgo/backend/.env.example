# TravelGo Backend & Database Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL + PostGIS (khớp với docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=travelgo2026
DB_NAME=travelgo_dev
DB_SSL=false

# JWT Secret & Auth
JWT_SECRET=travelgo-super-secret-key-2026-change-in-prod
JWT_EXPIRES_SECONDS=28800

# Bayesian Algorithm Configuration
BAYESIAN_MIN_REVIEWS=10
BAYESIAN_MEAN_PRIOR=4.20

# CORS Origins (phân tách bởi dấu phẩy)
APP_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed password (bắt buộc khi chạy npm run seed, tối thiểu 12 ký tự)
SEED_PASSWORD=travelgo2026seed

# pgAdmin (Docker)
PGADMIN_EMAIL=admin@hugotravel.vn
PGADMIN_PASSWORD=admin123
