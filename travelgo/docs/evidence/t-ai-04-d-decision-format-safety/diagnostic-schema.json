{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "tool",
        "clarify",
        "unsupported"
      ]
    },
    "name": {
      "type": "string",
      "enum": [
        "plan_trip",
        "search_places"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": [
          "departureCity",
          "destinationCity",
          "startDate",
          "endDate",
          "adults",
          "totalBudget",
          "transportation",
          "dailyBudgetPerPerson"
        ]
      }
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "departureCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "destinationCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "adults": {
          "type": "integer",
          "minimum": 1
        },
        "children": {
          "type": "integer",
          "minimum": 0
        },
        "totalBudget": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transportation": {
          "type": "string",
          "enum": [
            "car",
            "motorbike"
          ]
        },
        "pacing": {
          "type": "string",
          "enum": [
            "balanced"
          ]
        },
        "preferences": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "bien",
              "thien-nhien",
              "van-hoa",
              "am-thuc",
              "nghi-duong",
              "check-in",
              "phieu-luu",
              "mua-sam"
            ]
          }
        },
        "mandatoryPlaceIds": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "dailyBudgetPerPerson": {
          "type": "number",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "enum": [
            "hotel",
            "restaurant",
            "attraction",
            "tour"
          ]
        }
      }
    }
  }
}
