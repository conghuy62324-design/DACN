+  await assert.rejects(h.service.chat(user, { message: noTransport }), code('AGENT_INVALID_PROVIDER_OUTPUT'));
+  assert.equal(h.rejected[0] instanceof MissingReadSlotsRejection, false); assert.equal(h.executed.length, 0); assert.equal(h.calls.length, 1);
