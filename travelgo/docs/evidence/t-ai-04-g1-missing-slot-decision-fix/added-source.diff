+test('HTTP MOCK_ONLY: authenticated recovery is 200 needs_input; malformed/network failures remain safe 502', async () => {
+  for (const options of [{}, { rawText: '{malformed' }, { network: true }] as Options[]) {
+    const h = harness(partial, options), app = express(); app.use(express.json());
+    app.use('/api/agent', createAgentRouter(h.service));
+    const server = await new Promise<Server>(resolve => { const s = app.listen(0, '127.0.0.1', () => resolve(s)); });
+    try {
+      const address = server.address(); assert.ok(address && typeof address !== 'string');
+      const token = signAccessToken(user);
+      const post = (authenticated: boolean) => new Promise<{ status: number; cache: string; body: any }>((resolve, reject) => {
+        const req = request({ hostname: '127.0.0.1', port: address.port, path: '/api/agent/chat', method: 'POST',
+          headers: { 'Content-Type': 'application/json', Connection: 'close', ...(authenticated ? { Authorization: 'Bearer ' + token } : {}) } }, res => {
+          let text = ''; res.setEncoding('utf8'); res.on('data', chunk => text += chunk);
+          res.on('end', () => resolve({ status: res.statusCode, cache: String(res.headers['cache-control']), body: JSON.parse(text) }));
+        });
+        req.on('error', reject); req.end(JSON.stringify({ message: noTransport }));
+      });
+      const anonymous = await post(false); assert.equal(anonymous.status, 401); assert.equal(h.calls.length, 0);
+      const actual = await post(true); assert.equal(actual.cache, 'no-store');
+      if (!options.rawText && !options.network) {
+        assert.equal(actual.status, 200); assert.equal(actual.body.success, true);
+        assert.equal(actual.body.data.status, 'needs_input'); assert.deepEqual(actual.body.data.missingFields, ['transportation']);
