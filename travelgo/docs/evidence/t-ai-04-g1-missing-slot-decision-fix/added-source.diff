+
+test('timeout and ordinary invalid-output HttpError cannot impersonate classified missing-slot rejection', async () => {
+  const slow = new AgentOrchestrator({ provider: { configured: true, generate: async () => new Promise<never>(() => {}) },
+    timeoutMs: 5, readConsent: async () => ({ personalizationEnabled: false }), tools: { execute: async () => { throw Error('NO TOOL'); } } });
+  await assert.rejects(slow.chat(user, { message: noTransport }), code('AGENT_TIMEOUT'));
+  const generic = new HttpError(502, 'TEST_ONLY', 'AGENT_INVALID_PROVIDER_OUTPUT');
