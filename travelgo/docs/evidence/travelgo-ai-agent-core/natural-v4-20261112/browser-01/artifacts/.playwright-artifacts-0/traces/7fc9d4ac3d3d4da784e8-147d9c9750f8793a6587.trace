","__playwright_checked_":"false","__playwright_target__":"","type":"checkbox"}],"Cho phép trợ lý nhớ thông tin chuyến đi trong phiên này (tối đa 15 phút)."]],["DETAILS",{"class":"rounded-xl border bg-white p-4"},["SUMMARY",{"class":"cursor-pointer font-semibold"},"Tuỳ chọn lọc và chuyến đi đã lưu"],["DIV",{"class":"mt-3 grid gap-3 sm:grid-cols-2"},["DIV",{"class":"min-w-0","data-location-picker":"true"},["SPAN",{"id":":r1:-label","class":"mb-1 block text-xs font-semibold text-slate-700"},"Khu vực Agent"],["BUTTON",{"type":"button","role":"combobox","aria-labelledby":":r1:-label","aria-expanded":"false","aria-controls":":r1:-list","aria-haspopup":"listbox","class":"flex w-full items-center justify-between gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-left text-sm text-slate-800 disabled:opacity-50"},["SPAN",{"class":"min-w-0"},["SPAN",{"class":"block truncate"},"Chọn địa điểm"]],["SPAN",{"aria-hidden":"true"},"⌄"]]],["LABEL",{},"Giá từ tối đa (VND)",["INPUT",{"__playwright_value_":"","aria-label":"Giá từ tối đa","type":"number","min":"0","class":"w-full rounded border p-2","value":""}]],["LABEL",{},"Tiện ích bắt buộc, ngăn bởi dấu phẩy",["INPUT",{"__playwright_value_":"","class":"w-full rounded border p-2","value":""}]],["LABEL",{},"Sở thích ưu tiên",["INPUT",{"__playwright_value_":"","class":"w-full rounded border p-2","value":""}]],["LABEL",{},"Mã Trip của tôi (trống để lưu mới)",["INPUT",{"__playwright_value_":"","aria-label":"Mã chuyến đi","class":"w-full rounded border p-2","value":""}]],["LABEL",{"class":"flex gap-2 text-sm"},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"false","type":"checkbox"}],"Cho phép dùng thông tin chuyến đi đã lưu để tính lại trong phiên; không dùng ghi chú riêng tư hoặc thông tin tài khoản."]]],["DIV",{"role":"log","aria-label":"Hội thoại TravelGo","aria-live":"polite","class":"h-[58dvh] min-h-[300px] space-y-5 overflow-y-auto rounded-2xl border bg-slate-50 p-4 [overflow-wrap:anywhere]"},["ARTICLE"