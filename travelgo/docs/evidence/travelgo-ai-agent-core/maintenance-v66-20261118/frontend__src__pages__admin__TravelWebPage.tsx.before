import {useEffect,useState} from 'react';
import {ReviewCenterSummary,CandidateFacts,StoredKnowledge} from './TravelKnowledgeReview';
import {api} from '../../services/api';
import {safeWebLink,formatCostPrice,costCategoryLabels,costUnitLabels,readCostObservation} from '../../utils/webSourceCards';
const empty={domain:'',publisher:'',sourceClass:'UNKNOWN',homepage:'',method:'ARTICLE',endpoint:'',articleUrls:[] as string[],permissionUrl:'',license:'UNVERIFIED',identityEvidence:'',robotsText:'',robotsReviewedAt:'',intervalHours:6,rateSeconds:10,retentionDays:30,independenceGroup:'',independenceEvidenceUrl:''};
const fields:Record<string,string>={origin:'Nơi xuất phát',days:'Số ngày',nights:'Số đêm',party:'Số khách',rooms:'Số phòng',travelPeriod:'Thời điểm nguồn giá/chuyến đi',transportation:'Phương tiện',accommodationType:'Loại lưu trú',travelStyle:'Phong cách'};
const errorText=(e:any)=>e?.code==='WEB_REVISION_CONFLICT'?'Bản nguồn hoặc candidate đã thay đổi (409). Bản nhập của bạn được giữ; tải lại và đối chiếu version trước khi gửi.':e?.code==='WEB_SOURCE_NOT_APPROVED'||e?.code==='WEB_ROBOTS_DENIED'?'Nguồn chưa đủ quyền/robots; không nhập hoặc duyệt để bỏ qua điều kiện này.':e?.code==='WEB_CORRECTION_INVALID'?'Số tiền, đơn vị hoặc khoảng chưa hợp lệ. Kiểm lại dữ liệu nguồn; bản nhập vẫn được giữ.':e?.code==='FORBIDDEN'||e?.code==='WEB_READ_ONLY'?'Chưa có quyền ghi hoặc hệ thống đang chỉ đọc.':'Chưa thực hiện được. Kiểm evidence, quyền, version và thời hạn; bản nhập vẫn được giữ.';
const known=(v:any)=>v===null||v===undefined?'chưa xác định':String(v);
export default function TravelWebPage(){
 const[data,setData]=useState<any>(),[error,setError]=useState(''),[busy,setBusy]=useState(false),[draft,setDraft]=useState<any>(empty),[editing,setEditing]=useState<any>(),[reason,setReason]=useState(''),[confirmed,setConfirmed]=useState(false),[expires,setExpires]=useState(''),[imports,setImports]=useState<Record<string,string>>({}),[correction,setCorrection]=useState<any>(),[correctionField,setCorrectionField]=useState('party'),[correctionValue,setCorrectionValue]=useState(''),[evidence,setEvidence]=useState(''),[costEdit,setCostEdit]=useState<any>(),[history,setHistory]=useState<Record<string,any[]>>({}),[selections,setSelections]=useState<Record<string,{observationIds:string[];factHashes:string[]}>>({});
 const[technicalBusy,setTechnicalBusy]=useState(false);
 const[reviewFilter,setReviewFilter]=useState('ALL'),[factEdit,setFactEdit]=useState<any>();
 const selectionFor=(c:any)=>selections[c.id+':'+c.version]||{observationIds:[],factHashes:[]};
 const toggleFact=(c:any,key:'observationIds'|'factHashes',id:string)=>setSelections(v=>{const old=selectionFor(c);return{...v,[c.id+':'+c.version]:{...old,[key]:old[key].includes(id)?old[key].filter(x=>x!==id):[...old[key],id]}};});
 const load=async()=>{const r:any=await api.get('/admin/travel-web');setData(r.data);const expiry=r.data?.operation?.preparedReview?.knowledgeExpiresAt;if(expiry){const date=new Date(expiry);setExpires(v=>v||new Date(date.getTime()-date.getTimezoneOffset()*60000).toISOString().slice(0,16));}};
 useEffect(()=>{void load().catch(()=>setError('Chưa tải được quản trị web knowledge.'));},[]);
 const writable=data?.status==='SCOPED_WRITE',reviewReady=writable&&!busy&&!technicalBusy&&confirmed&&reason.trim().length>=3;
 const action=async(path:string,body:any,method='post')=>{if(busy)return false;setBusy(true);setError('');try{await api.request({url:'/admin/travel-web'+path,method,data:body});await load();setConfirmed(false);return true;}catch(e){setError(errorText(e));return false;}finally{setBusy(false);}};
 const sourceDecision=async(s:any,decision:string)=>{if(technicalBusy)return;const requestReason=reason,requestConfirmed=confirmed,prep=data?.operation?.preparedReview;setTechnicalBusy(true);try{const ok=await action('/sources/'+s.id+'/moderation',{decision,version:s.version,reason:requestReason,confirmed:requestConfirmed});if(!ok||decision!=='APPROVE'||prep?.sourceId!==s.id)return;const fresh:any=await api.get('/admin/travel-web'),source=fresh.data.sources.find((v:any)=>v.id===prep.sourceId),candidate=fresh.data.candidates.find((v:any)=>v.id===prep.candidateId);if(!source||!candidate||candidate.content_hash!==prep.contentHash||candidate.status!=='DRAFT')throw Error('PREPARATION_STATE_CHANGED');if(candidate.source_version===source.version&&candidate.extraction.travelPeriod===prep.travelPeriod)return;await action('/candidates/'+candidate.id+'/extraction',{version:candidate.version,confirmed:requestConfirmed,reason:requestReason,evidenceReference:candidate.canonical_url,rebindSource:true,sourceVersion:source.version,contentHash:prep.contentHash,changes:{travelPeriod:prep.travelPeriod}},'patch');}catch{setError('Nguồn đã được xử lý nhưng snapshot chưa sẵn sàng. Dừng duyệt fact, tải lại version và báo trạng thái; không duyệt nguồn lần nữa để thử.');}finally{setTechnicalBusy(false);}};
 const revisions=async(id:string)=>{try{const r:any=await api.get('/admin/travel-web/candidates/'+id+'/history');setHistory(h=>({...h,[id]:r.data.revisions}));}catch(e){setError(errorText(e));}};
 const chooseCorrection=(c:any,o?:any)=>{setCorrection(c);setEvidence(c.canonical_url);setCorrectionValue('');setFactEdit(undefined);setCostEdit(o?{...o,amountMin:o.amountMin??o.amount,amountMax:o.amountMax??o.amount,priceBound:o.priceBound||'EXACT'}:undefined);};
 const saveCorrection=async()=>{let changes:any;try{if(factEdit){changes={facts:[{evidenceHash:factEdit.evidenceHash,summary:factEdit.summary}]};}else if(costEdit){const b=costEdit.priceBound,amount=b==='EXACT'?costEdit.amountMin:null,amountMin=b==='AT_MOST'?null:costEdit.amountMin,amountMax=b==='AT_LEAST'?null:b==='EXACT'?costEdit.amountMin:costEdit.amountMax,category=costEdit.costCategory==='TOTAL_TRIP'?'TOTAL':costEdit.costCategory==='ATTRACTION'?'SIGHTSEEING':costEdit.costCategory;readCostObservation({amount,amountMin,amountMax,priceBound:b,schemaVersion:2,currency:costEdit.currency,unit:costEdit.unit,category,included:costEdit.included,excluded:costEdit.excluded,inclusionStatus:costEdit.inclusionStatus});changes={costs:[{observationId:costEdit.observationId,amount,amountMin,amountMax,priceBound:b,currency:costEdit.currency,unit:costEdit.unit,costCategory:costEdit.costCategory}]};}else{const numeric=['days','nights','party','rooms'].includes(correctionField),raw=correctionValue.trim();if(raw&&numeric&&!/^\d{1,3}$/.test(raw))throw Error('numeric');changes={[correctionField]:raw?numeric?Number(raw):raw:null};}}catch{setError('Giá trị nhập chưa đúng kiểu hoặc khoảng. Không gửi bản sửa; dữ liệu đang nhập được giữ.');return;}if(await action('/candidates/'+correction.id+'/extraction',{version:correction.version,confirmed,reason,evidenceReference:evidence,changes,...(data.sources.find((s:any)=>s.id===correction.source_id)?.version!==correction.source_version?{rebindSource:true,sourceVersion:data.sources.find((s:any)=>s.id===correction.source_id)?.version,contentHash:correction.content_hash}:{})},'patch')){setCorrection(undefined);setCostEdit(undefined);setFactEdit(undefined);}};
 const saveSource=()=>{const input={...draft};for(const k of['endpoint','independenceGroup','independenceEvidenceUrl'])if(!input[k])delete input[k];if(Boolean(input.independenceGroup)!==Boolean(input.independenceEvidenceUrl)){setError('Nhóm nguồn độc lập cần kèm liên kết evidence để reviewer đối chiếu.');return;}void action(editing?'/sources/'+editing.id:'/sources',{...input,...(editing?{version:editing.version}:{})},editing?'patch':'post');};
 return <main className="min-w-0 space-y-5 break-words"><h1 className="text-2xl font-bold">Nguồn web & kiến thức du lịch</h1><p>Worker chỉ tạo candidate. Chỉ SUPER_ADMIN duyệt nguồn và kiến thức; chỉnh sửa nguồn yêu cầu duyệt lại. Không dùng chi phí bài viết làm báo giá dịch vụ.</p><p>Chế độ: {data?.status||'đang tải'}. Lịch discovery tối thiểu6h; refresh theo policy; worker mặc định tắt.</p>{error&&<p role="alert" className="rounded border border-amber-600 p-3">{error}</p>}<button className="underline" disabled={busy} onClick={()=>void load().catch(()=>setError('Chưa tải lại được.'))}>Tải lại dữ liệu và version</button>
 <ReviewCenterSummary data={data} filter={reviewFilter} onFilter={setReviewFilter}/>
 <section className="space-y-3 rounded border bg-white p-4"><h2 className="font-bold">{editing?'Sửa nguồn (cần duyệt lại)':'Thêm nguồn chưa duyệt'}</h2><div className="grid gap-3 md:grid-cols-2">{[['domain','Domain chính xác'],['publisher','Nhà xuất bản'],['homepage','Trang chủ HTTPS'],['permissionUrl','Liên kết quyền sử dụng/giấy phép'],['license','Giấy phép và nghĩa vụ ghi nguồn'],['identityEvidence','Bằng chứng danh tính nguồn'],['robotsReviewedAt','Robots đã kiểm lúc (ISO)'],['independenceGroup','Nhóm nguồn độc lập (chưa coi là đã xác minh)'],['independenceEvidenceUrl','Evidence nguồn độc lập HTTPS']].map(([key,label])=><label key={key}>{label}<input className="block w-full rounded border p-2" value={draft[key]||''} onChange={e=>setDraft({...draft,[key]:e.target.value})}/></label>)}<label>Loại nguồn<select className="block border p-2" value={draft.sourceClass} onChange={e=>setDraft({...draft,sourceClass:e.target.value})}>{['OFFICIAL','EDITORIAL','COMMUNITY_EXPERIENCE','COMMERCIAL','UNKNOWN'].map(s=><option key={s}>{s}</option>)}</select></label><label>Phương thức<select value={draft.method} onChange={e=>setDraft({...draft,method:e.target.value})}>{['ARTICLE','RSS','API','SITEMAP'].map(s=><option key={s}>{s}</option>)}</select></label><label>RSS/API/Sitemap endpoint<input className="block w-full border p-2" value={draft.endpoint||''} onChange={e=>setDraft({...draft,endpoint:e.target.value})}/></label>{[['intervalHours','Chu kỳ discovery (giờ)'],['rateSeconds','Khoảng cách request (giây)'],['retentionDays','Retention candidate (ngày)']].map(([key,label])=><label key={key}>{label}<input type="number" value={draft[key]} onChange={e=>setDraft({...draft,[key]:Number(e.target.value)})}/></label>)}</div><label className="block">Tối đa3 URL bài được phép<textarea className="block w-full border p-2" value={draft.articleUrls.join('\n')} onChange={e=>setDraft({...draft,articleUrls:e.target.value.split('\n').filter(Boolean)})}/></label><label className="block">robots.txt đã kiểm<textarea className="block w-full border p-2" value={draft.robotsText} onChange={e=>setDraft({...draft,robotsText:e.target.value})}/></label><button disabled={busy||!writable} onClick={saveSource} className="rounded border px-3 py-2">Lưu bản chưa duyệt</button><button onClick={()=>{setEditing(undefined);setDraft(empty);}} className="ml-3 underline">Nguồn mới</button></section>
 {data?.operation?.preparedReview&&<p role="status" className="rounded border bg-sky-50 p-3">Workflow đã chuẩn bị cho snapshot đang giữ: sau khi bạn duyệt source, website tự đối chiếu cùng content hash và ghi thời điểm lịch sử {data.operation.preparedReview.travelPeriod}. Không đổi số tiền/đơn vị và không duyệt fact tự động. Tiếp theo bạn chọn riêng khoản đã kiểm, xác nhận và bấm Duyệt kiến thức. Expiry chỉ là đề xuất trong scope; bạn có thể chọn sớm hơn.</p>}
 <section className="space-y-2"><h2 className="font-bold">Xác nhận quản trị</h2><input aria-label="Lý do xét duyệt web" className="w-full rounded border p-2" placeholder="Lý do và phạm vi đã kiểm" maxLength={240} value={reason} onChange={e=>setReason(e.target.value)}/><label className="flex gap-2"><input type="checkbox" checked={confirmed} onChange={e=>setConfirmed(e.target.checked)}/>Tôi đã kiểm quyền, nguồn gốc, context, đơn vị chi phí và phạm vi sử dụng</label><label>Kiến thức hết hạn vào<input aria-label="Web knowledge expiry" type="datetime-local" value={expires} onChange={e=>setExpires(e.target.value)}/></label></section>
 <section><h2 className="font-bold">Danh sách nguồn</h2>{data?.sources.map((s:any)=><article key={s.id} className="my-3 min-w-0 space-y-2 rounded border bg-white p-3"><p className="font-semibold">{s.config.publisher} · {s.domain}</p><p>{s.review_status} · {s.permission} · {s.enabled?'đang bật':'đã tắt'} · version{s.version}</p><p>License: {s.config.license}</p><p>Độc lập: {s.config.independenceGroup||'chưa có evidence độc lập; không đếm nhiều ngôn ngữ thành nhiều nguồn'}</p>{safeWebLink(s.config.independenceEvidenceUrl)&&<a className="block break-words underline" href={s.config.independenceEvidenceUrl} target="_blank" rel="noopener noreferrer">Evidence nguồn độc lập</a>}<p>Fetch tốt: {s.last_success||'chưa có'} · Lỗi: {s.last_error||'không'}</p><div className="flex flex-wrap gap-2"><button className="underline" onClick={()=>{setDraft({...empty,...s.config});setEditing(s);}}>Sửa nguồn</button>{[['APPROVE','Duyệt/bật'],['DISABLE','Tắt'],['REVOKE','Thu hồi']].map(([decision,label])=><button key={decision} disabled={!reviewReady||decision==='APPROVE'&&data.operation?.preparedReview?.sourceId===s.id&&s.review_status==='APPROVED'} className="rounded border p-2" onClick={()=>void sourceDecision(s,decision)}>{label}</button>)}<button disabled={busy||!s.enabled||!writable} className="underline" onClick={()=>void action('/sources/'+s.id+'/refresh',{})}>Yêu cầu cập nhật có giới hạn</button></div><label className="block">Nhập URL bài đã được phép<input aria-label={'URL bài '+s.domain} className="block w-full border p-2" value={imports[s.id]||''} onChange={e=>setImports({...imports,[s.id]:e.target.value})}/></label><button disabled={busy||!confirmed||!imports[s.id]||!s.enabled||!writable} className="rounded border p-2" onClick={()=>void action('/sources/'+s.id+'/import',{url:imports[s.id],version:s.version,confirmed})}>Nhập bài chờ xử lý</button><details><summary>Lịch sử version nguồn</summary>{s.history.map((h:any,i:number)=><p key={i}>Version{h.version} · {h.decision||'sửa cấu hình'} · {h.reason||h.at}</p>)}</details></article>)}</section>
 <section><h2 className="font-bold">Bài viết/candidate mới</h2>{data?.candidates.filter((c:any)=>reviewFilter==='ALL'||reviewFilter==='REAL'?! (reviewFilter==='REAL'&&c.extraction.synthetic===true):reviewFilter==='SYNTHETIC'?c.extraction.synthetic===true:c.status===reviewFilter).map((c:any)=>{const x=c.extraction,source=data.sources.find((s:any)=>s.id===c.source_id);return <article key={c.id} className="my-3 min-w-0 space-y-2 rounded border bg-white p-3"><p className="font-semibold">{x.title}</p><p>{x.synthetic?'[SYNTHETIC TEST DATA] ':'[REAL UNREVIEWED / kiểm trạng thái duyệt] '}{c.status} · {c.quality} · version{c.version}</p>{safeWebLink(c.canonical_url)&&<a className="break-words underline" href={c.canonical_url} target="_blank" rel="noopener noreferrer">Mở bài gốc</a>}<p>Điểm đến: {x.locationId?.replace('destination:','').replaceAll('-',' ')||'chưa xác minh'}. Nhà xuất bản: {x.publisher||source?.config.publisher||'chưa xác minh'}.</p><p>License: {source?.config.license||'chưa xác minh'}. Nguồn độc lập: {source?.config.independenceGroup||'chưa được chứng minh'}</p><p>Ngày đăng {known(x.publishedAt)} · Chuyến đi {known(x.travelPeriod)} · Truy xuất {known(x.retrievedAt)}</p><p>Xuất phát {known(x.origin)} · {known(x.days)} ngày/{known(x.nights)} đêm · {known(x.party)} khách · {known(x.rooms)} phòng · {known(x.transportation)}</p>{safeWebLink(source?.config.permissionUrl)&&<a className="block underline" href={source.config.permissionUrl} target="_blank" rel="noopener noreferrer">Xem giấy phép và yêu cầu ghi nguồn</a>}<p>Attribution: {x.publisher||'nhà xuất bản ở bài gốc'} · bài gốc và lịch sử tác giả · giấy phép áp dụng · nêu rõ phần trích/diễn giải đã thay đổi.</p><p>Đã chọn {selectionFor(c).observationIds.length} khoản chi và {selectionFor(c).factHashes.length} fact cho revision này; phần còn lại không được kích hoạt.</p><p>Chỉ các mục được tích riêng mới được duyệt. Mục chưa chọn vẫn là evidence chưa được phép dùng; duyệt nguồn không đồng nghĩa duyệt mọi giá.</p><CandidateFacts candidate={c} selected={selectionFor(c).factHashes} writable={writable} busy={busy} onToggle={hash=>toggleFact(c,'factHashes',hash)} onEdit={fact=>{chooseCorrection(c);setFactEdit({...fact});}}/>{x.costs.map((o:any,i:number)=><section key={i} aria-label={'Khoản chi nguồn '+(i+1)} className="space-y-1 rounded border p-3"><label className="flex gap-2"><input type="checkbox" aria-label={'Chọn khoản '+(i+1)+' '+x.title} disabled={!writable||busy||!o.observationId} checked={selectionFor(c).observationIds.includes(o.observationId)} onChange={()=>toggleFact(c,'observationIds',o.observationId)}/>Duyệt riêng khoản này</label><p className="font-semibold">{formatCostPrice(o)} · {costCategoryLabels[o.costCategory||o.category]}</p><p>Bao gồm {o.included.join(', ')||'chưa xác định'}; chưa gồm {o.excluded.join(', ')||'chưa xác định'}</p><p>Locator: {o.evidenceLocator||'chưa có'}. Hiệu lực {known(o.validFrom)} – {known(o.validUntil)}; không tự coi retrievedAt là ngày áp dụng giá.</p>{o.sourceContext?<div className="space-y-1 break-words"><p>Section: {o.sourceContext.headings.join(' › ')||'không có heading đủ rõ'}</p>{o.sourceContext.tableHeaders.length>0&&<p>Header bảng: {o.sourceContext.tableHeaders.join(' · ')}</p>}<blockquote className="border-l-2 pl-3">{o.sourceContext.preceding&&<p>Trước: {o.sourceContext.preceding}</p>}<p>Nguồn: {o.sourceContext.quote}</p>{o.sourceContext.following&&<p>Sau: {o.sourceContext.following}</p>}</blockquote><p>Căn cứ phân loại: {o.sourceContext.rationale}</p><p>Không dùng confidence% để thay reviewer; UNKNOWN vẫn cần kiểm nguồn.</p></div>:<p>Snapshot cũ chưa lưu structured context; cần đối chiếu bài gốc, không tự bổ sung rationale.</p>}<button className="rounded border p-2" disabled={busy||!writable} onClick={()=>chooseCorrection(c,o)}>Sửa khoản nguồn {i+1}</button></section>)}<button className="rounded border p-2" disabled={busy||!writable} onClick={()=>chooseCorrection(c)}>Sửa dữ liệu theo bài gốc</button><details><summary>Lịch sử sửa dữ liệu</summary>{x.reviewRevisions?.map((r:any,i:number)=><p className="break-words" key={i}>Bản {r.version} · {r.reason} · {r.evidenceReference}</p>)}</details><button className="underline" onClick={()=>void revisions(c.id)}>Xem snapshot đã duyệt</button>{history[c.id]?.map((r:any)=><details key={r.id}><summary>Snapshot version{r.version} · {r.status} · {r.currentSnapshot?'bản candidate hiện đang trỏ tới':'bản lịch sử; chưa được coi còn eligible'}</summary><p>Candidate revision{r.candidateVersion} · Source version{r.sourceVersion} · {known(r.snapshot.party)} khách/{known(r.snapshot.days)} ngày</p>{r.snapshot.costs.map((o:any,i:number)=><p key={i}>{formatCostPrice(o)}</p>)}</details>)}<div className="flex flex-wrap gap-2">{[['APPROVE','Duyệt kiến thức'],['REJECT','Từ chối'],['REVOKE','Thu hồi']].map(([decision,label])=><button key={decision} disabled={!reviewReady||decision==='APPROVE'&&(x.synthetic!==true&&!data.operation?.realOwnerReview||!expires||!selectionFor(c).observationIds.length&&!selectionFor(c).factHashes.length)} className="rounded border p-2" onClick={()=>void action('/candidates/'+c.id+'/review',{decision,version:c.version,reason,confirmed,...(decision==='APPROVE'?{expiresAt:new Date(expires).toISOString(),selection:selectionFor(c)}:{})})}>{label}</button>)}</div></article>;})}</section>
 {correction&&<section className="space-y-3 rounded border bg-white p-4"><h2 className="font-bold">Sửa candidate — phải duyệt lại</h2><p>Bản nhập đang dựa trên version{correction.version}; không overwrite snapshot đã duyệt.</p>{data.sources.find((s:any)=>s.id===correction.source_id)?.version!==correction.source_version&&<p className="rounded bg-amber-50 p-2">Nguồn đã đổi revision. Lưu bản sửa này xác nhận đối chiếu lại đúng content hash của DRAFT đang giữ; chỉ chấp nhận lần duyệt nguồn liền kề, không tự lấy lại bài hoặc thay evidence. Nếu cấu hình nguồn đã đổi, hệ thống sẽ từ chối.</p>}{factEdit?<label className="block">Fact theo evidence<textarea aria-label="Nội dung fact đã đối chiếu" maxLength={600} className="block w-full border p-2" value={factEdit.summary} onChange={e=>setFactEdit({...factEdit,summary:e.target.value})}/><p>Locator: {factEdit.evidence?.locator}</p><blockquote>{factEdit.evidence?.quote}</blockquote></label>:!costEdit?<><label className="block">Field nguồn<select aria-label="Field sửa nguồn" value={correctionField} onChange={e=>setCorrectionField(e.target.value)}>{Object.entries(fields).map(([key,label])=><option key={key} value={key}>{label}</option>)}</select></label><label className="block">Giá trị nguồn (để trống nếu chưa xác định)<input aria-label="Giá trị sửa nguồn" className="block w-full border p-2" value={correctionValue} onChange={e=>setCorrectionValue(e.target.value)}/></label></>:<div className="grid gap-2 md:grid-cols-2"><label>Phạm vi số tiền<select aria-label="Phạm vi số tiền" value={costEdit.priceBound} onChange={e=>setCostEdit({...costEdit,priceBound:e.target.value})}>{[['EXACT','Một mức tiền'],['RANGE','Khoảng tiền'],['AT_MOST','Không quá'],['AT_LEAST','Từ mức này']].map(([key,label])=><option key={key} value={key}>{label}</option>)}</select></label>{['amountMin','amountMax'].map(key=><label key={key}>{key==='amountMin'?'Số tiền/cận dưới':'Cận trên'}<input aria-label={key==='amountMin'?'Số tiền/cận dưới':'Cận trên'} type="number" min="0" max="1000000000" className="block w-full border p-2" value={costEdit[key]??''} onChange={e=>setCostEdit({...costEdit,[key]:e.target.value===''?null:Number(e.target.value)})}/></label>)}<label>Tiền tệ<select value={costEdit.currency} onChange={e=>setCostEdit({...costEdit,currency:e.target.value})}>{['VND','USD','EUR','GBP','UNKNOWN'].map(key=><option key={key}>{key}</option>)}</select></label><label>Nhóm khoản<select value={costEdit.costCategory} onChange={e=>setCostEdit({...costEdit,costCategory:e.target.value})}>{Object.entries(costCategoryLabels).filter(([key])=>!['TOTAL','SIGHTSEEING','RESERVE'].includes(key)).map(([key,label])=><option key={key} value={key}>{label}</option>)}</select></label><label>Đơn vị<select value={costEdit.unit} onChange={e=>setCostEdit({...costEdit,unit:e.target.value})}>{Object.entries(costUnitLabels).map(([key,label])=><option key={key} value={key}>{label}</option>)}</select></label></div>}<label className="block">Evidence trong đúng bài gốc<input aria-label="Evidence sửa nguồn" className="block w-full border p-2" value={evidence} onChange={e=>setEvidence(e.target.value)}/></label><button disabled={!reviewReady||!evidence} className="rounded border p-2" onClick={()=>void saveCorrection()}>Lưu bản sửa chờ duyệt</button><button className="ml-3 underline" onClick={()=>setCorrection(undefined)}>Đóng bản nhập</button></section>}
 <StoredKnowledge items={data?.knowledge||[]}/>
 <section><h2 className="font-bold">Job cập nhật</h2>{data?.jobs.map((j:any)=><p key={j.id}>Lần tới {j.next_due} · {j.kind} · {j.last_error||'không lỗi'} · attempts{j.attempts}</p>)}</section></main>;
}
