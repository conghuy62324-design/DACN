const assert=require('assert/strict'),crypto=require('crypto');module.exports=async c=>{const{db,lock,save}=c,id=n=>lock.fixtureIds['f'+n],{http}=require('./http.cjs')(c),source=(await db.query('SELECT quote_snapshot FROM hotel_booking_stays WHERE booking_id=$1',[id(100)])).rows[0].quote_snapshot;
 assert.equal((await db.query('SELECT count(*)::int n FROM bookings WHERE id=$1',[id(70)])).rows[0].n,0);
 const dates=[lock.dates.completedCheckIn,new Date(Date.parse(lock.dates.completedCheckIn+'T00:00:00Z')+86400000).toISOString().slice(0,10)],snapshot=structuredClone(source);snapshot.fixturePurpose='SYNTHETIC completed-stay attribution readiness, not evidence of a real historical stay';snapshot.quote={...snapshot.quote,checkIn:lock.dates.completedCheckIn,checkOut:lock.dates.completedCheckOut,nightly:snapshot.quote.nightly.map((n,i)=>({...n,stayDate:dates[i]}))};snapshot.sourceVersion=crypto.createHash('sha256').update('SYNTHETIC-PAST-STAY-D').digest('hex');snapshot.quote.sourceVersion=snapshot.sourceVersion;
 save('completed-fixture-plan',{bookingId:id(70),itemId:id(71),allocationIds:[id(72),id(73)],dates,expected:'CUSTOMER completion403; Partner CONFIRMED then COMPLETED200; native attributed item/owner preserved; no review writes'});
 await db.query('BEGIN');try{
 for(const date of dates)await db.query('INSERT INTO hotel_room_inventory(room_type_id,place_id,stay_date,sellable_quantity) VALUES($1,$2,$3,1)',[id(40),id(20),date]);
 await db.query("INSERT INTO bookings(id,booking_code,user_id,business_id,place_id,service_type,service_id,service_name,customer_name,customer_email,customer_phone,booking_date,return_date,adults_count,children_count,quantity,unit_price,total_amount,discount_amount,payment_status,booking_status,idempotency_key,request_fingerprint) VALUES($1,'HG-SYNTHETIC-COMPLETED-D',$2,$3,$4::uuid,'hotel',$4::text,$5,'SYNTHETIC past guest','past@hotel-2138d.invalid','0900000001',$6,$7,2,0,1,1000000,2228000,220000,'unpaid','PENDING','d-synthetic-past',$8)",[id(70),id(1),id(9),id(20),snapshot.hotel.name,lock.dates.completedCheckIn,lock.dates.completedCheckOut,snapshot.sourceVersion]);
 await db.query('INSERT INTO hotel_booking_stays(booking_id,place_id,business_id,check_in,check_out,total_vnd,source_version,quote_snapshot) VALUES($1,$2,$3,$4,$5,2228000,$6,$7::jsonb)',[id(70),id(20),id(9),lock.dates.completedCheckIn,lock.dates.completedCheckOut,snapshot.sourceVersion,JSON.stringify(snapshot)]);
 await db.query('INSERT INTO hotel_booking_items(id,booking_id,place_id,room_type_id,rate_plan_id,quantity,occupancy,total_vnd,quote_snapshot) VALUES($1,$2,$3,$4,$5,1,$6::jsonb,2228000,$7::jsonb)',[id(71),id(70),id(20),id(40),id(81),JSON.stringify(snapshot.occupancy),JSON.stringify(snapshot)]);
 for(let i=0;i<dates.length;i++)await db.query('INSERT INTO hotel_room_allocations(id,booking_item_id,room_type_id,stay_date,quantity) VALUES($1,$2,$3,$4,1)',[id(72+i),id(71),id(40),dates[i]]);await db.query('COMMIT');}catch(e){await db.query('ROLLBACK');throw e;}
 await http('customerA','PATCH','/bookings/'+id(70)+'/status',{status:'COMPLETED'},undefined,403);await http('partnerA','PATCH','/partner/bookings/'+id(70)+'/status',{businessId:id(9),status:'CONFIRMED'});const b=(await http('partnerA','PATCH','/partner/bookings/'+id(70)+'/status',{businessId:id(9),status:'COMPLETED'})).data;assert.equal(b.bookingStatus,'COMPLETED');assert.equal(b.paymentStatus,'unpaid');
 const proof=(await db.query("SELECT b.id,b.user_id,b.booking_status,b.payment_status,s.check_out::text,i.id item_id,i.room_type_id FROM bookings b JOIN hotel_booking_stays s ON s.booking_id=b.id JOIN hotel_booking_items i ON i.booking_id=b.id WHERE b.id=$1",[id(70)])).rows[0];assert.equal(proof.user_id,id(1));assert.equal(proof.room_type_id,id(40));assert.equal((await db.query('SELECT count(*)::int n FROM reviews')).rows[0].n,0);assert.equal((await db.query('SELECT count(*)::int n FROM hotel_review_stays')).rows[0].n,0);save('native-completed-attribution',{status:'PASS',proof,fixture:'SYNTHETIC past stay',actualPartnerTransitions:true,customerSelfCompletionDenied:true,reviewSubmissionNotImplementedInD:true,reviewRows:0});
};
