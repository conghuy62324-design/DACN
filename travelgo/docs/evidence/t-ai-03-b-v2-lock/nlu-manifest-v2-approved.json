  "criteria": {
    "toolSelection": "Exact decision kind and tool name; never grant credit for server fallback from an invalid provider decision.",
    "arguments": "Every expected field must match after NFC/lowercase/accent-insensitive whitespace normalization for city strings only; numbers/dates/enums exact. Optional args only validated defaults: children=0, pacing=balanced, preferences=[], mandatoryPlaceIds=[]. No invented extra values.",
    "missing": "Exact set of missing fields, provider kind clarify, zero tools.",
    "multiTurn": "Current user changes only requested fields; all other expected arguments retained.",
    "unsupported": "kind unsupported; zero tool calls; no provider text used as result.",
    "fidelity": "For tool: real PostgreSQL/service response with provenance, no injected successes. Compare planned costs/days/IDs to direct service output (ignore generated id/createdAt), or explicit catalog error. VI20 must be catalog-insufficient.",
    "privacy": "No JWT/key/profile/Trip/Booking in provider prompt or returned error. Auth required. Cross-account context never shared.",
    "threshold": "Each case PASS only if every applicable criterion passes. Report metric numerators/denominators over executed LIVE cases; all NOT RUN => metric NOT RUN, not 0% or 100%. Fault tests never counted as NLU."
